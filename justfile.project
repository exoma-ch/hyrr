# ═══════════════════════════════════════════════════════════════════════════════
# PROJECT RECIPES - Team-shared customizations
# This file is git-tracked and preserved during devcontainer upgrades.
# Add team-shared recipes here that everyone on the project should use.
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# PROJECT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════════

project := "hyrr"

# ═══════════════════════════════════════════════════════════════════════════════
# INFO
# ═══════════════════════════════════════════════════════════════════════════════

# Show project information
[group('info')]
info:
    @echo "Project: {{project}}"

# ═══════════════════════════════════════════════════════════════════════════════
# PROJECT-SPECIFIC RECIPES
# ═══════════════════════════════════════════════════════════════════════════════

# Full local dev: build WASM + copy data + start vite
[group('dev')]
dev *args:
    scripts/dev.sh {{args}}

# Dev server without WASM rebuild (fast restart)
[group('dev')]
dev-fast *args:
    scripts/dev.sh --skip-wasm {{args}}

# Build WASM only
[group('dev')]
wasm:
    wasm-pack build wasm/ --target web --out-dir ../frontend/src/lib/compute/hyrr-wasm-pkg

# Build the hyrr._native PyO3 extension into src/hyrr (needed for tests/integration)
[group('dev')]
build-native *args:
    scripts/build-native.sh {{args}}

# Run the integration suite (builds _native first; resolves data from the submodule)
[group('test')]
test-integration *args:
    scripts/build-native.sh
    HYRR_DATA="${HYRR_DATA:-$PWD/nucl-parquet/data}" uv run pytest tests/integration {{args}}

# Copy nuclear data to frontend
[group('dev')]
data:
    scripts/copy-frontend-data.sh nucl-parquet/data frontend/public/data/parquet

# Re-pin the data-tarball integrity hash after a nucl-parquet submodule bump (#577).
# Pass --verify-download to hash the asset yourself instead of trusting GitHub's
# published digest. Commit hyrr.json alongside the submodule bump.
[group('dev')]
repin-data *args:
    scripts/repin-data.sh {{args}}

# Manual deploy to GitHub Pages tst/
[group('deploy')]
deploy-tst:
    scripts/deploy-staging-manual.sh

# ── ETH webhosting (hyrr.ethz.ch) — promotion ladder: ent → tst → prd ──────────
# These build + rsync the frontend over SSH. They need ETH SSH reachability,
# which you have EITHER on the ETH network/VPN (direct) OR through the heimdall
# ProxyJump aliases in ssh_config — the latter works from vm-dev, contrary to
# what this file and deploy-eth.sh used to claim (#648). deploy-eth.sh picks the
# aliases up automatically when they define a ProxyJump.
#
# Two prerequisites on a host using the aliases:
#   ssh-add ~/.ssh/id_ed25519_ethz ~/.ssh/id_ed25519_eth-hyrr
#   sops must be able to decrypt secrets/eth-deploy.sops.env (the whitelist SSoT)
#
# GitHub runners still cannot deploy — heimdall rejects the key inside the sops
# bundle (#641), which is a separate problem from reachability.

# Build + deploy to one ETH instance (ent | tst | prd). prd confirms first.
[group('deploy')]
deploy-eth env:
    scripts/deploy-eth.sh {{env}}

# Assert prd's preconditions WITHOUT deploying: on main, clean tree, in sync
# with origin/main. `just elevate` runs this itself — use this to check first.
[group('deploy')]
deploy-eth-preflight:
    #!/usr/bin/env bash
    set -euo pipefail
    HYRR_DEPLOY_ETH_LIB=1 source scripts/deploy-eth.sh
    assert_prd_is_released_main

# Read-only: dump an instance's remote $HOME + conf/servers + resolved docroot.
[group('deploy')]
deploy-eth-probe env="ent":
    scripts/deploy-eth.sh probe {{env}}

# First-deploy ladder: build once → ent → tst (prd HELD for explicit OK).
[group('deploy')]
deploy-eth-ladder:
    scripts/deploy-eth.sh ladder

# Lift to PRODUCTION (https://hyrr.ethz.ch) — rebuilds indexable (noindex only
# applies to ent/tst), confirms, then deploys. Same source as the tst build.
# Refuses unless you are on main, clean, and level with origin/main (#648);
# there is no bypass flag. Run `just deploy-eth-preflight` to check first.
[group('deploy')]
elevate:
    scripts/deploy-eth.sh prd

# Plain HTTPS (unlike the deploys above), so this DOES work from vm-dev and CI.
# Pass --gate-only to assert just the licensing gate, with no version compare.
# Check a deployed instance from outside: version + AAI gate still active
[group('deploy')]
verify-deploy env *args:
    scripts/verify-deploy.sh {{env}} {{args}}

# Check a published release: tags, latest.json, PyPI wheel set, release notes
[group('deploy')]
verify-release version *args:
    scripts/verify-release.sh {{version}} {{args}}

# Run the Rust core suite across all three CI feature sets (default | mcp | embed)
[group('test')]
test-rust which="all":
    scripts/test-rust.sh {{which}}

# Run the shell-script tests (release gate + deploy/release verification)
[group('test')]
test-scripts:
    scripts/tests/run-all.sh

# Run frontend unit tests
[group('test')]
test-frontend:
    cd frontend && npx vitest run

# Run Playwright e2e tests (requires running dev server)
[group('test')]
test-e2e project="desktop-1280":
    cd frontend && npx playwright test --project={{project}}
